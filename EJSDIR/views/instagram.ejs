<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instagram</title>
    <style>
        img{
            height: 100px;
            width: 100px;
        }
    </style>
</head>
<body>
    <h2>This page belongs to @<%= data.name %> </h2>
    <button>Follow</button>
    <button>Message</button>

    <p>followers: <%= data.followers  %> &nbsp; &nbsp; &nbsp;&nbsp; followers: <%= data.following %></p>
    <hr>
    <!-- now we can print the all posts -->
     
    <% for(let post of data.posts){ %>   <!--only post is not allowed -->
        <img src="<%= post.image  %>" alt="some image">
        <p>likes: <%= post.likes  %> &nbsp; &nbsp; &nbsp;&nbsp; comments: <%= post.comments %></p>
        
    <% } %>






    <!-- <h3>Account that follows you: </h3>
    <ul>
         for(let name of followers) {   here i removed some < and % and = carfuuly see them
            <li> = name </li>  
       } 
    </ul> -->
</body>
</html>

